# ---------------------------------------------------------------------------
# Database (PostgreSQL). Any hosted Postgres works: Neon, Supabase, Railway, RDS.
# Prisma 7 uses a driver adapter, so a plain connection string is all you need.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/leetcode_challenge"
#
# If the password contains special characters they must be percent-encoded
# (@ becomes %40, # becomes %23, and so on), or the URL will not parse correctly.
#
# ---------------------------------------------------------------------------
# IMPORTANT for Supabase + any serverless host (Vercel, Netlify, Lambda):
#
# Supabase's direct endpoint (db.<ref>.supabase.co) resolves to IPv6 ONLY. Serverless
# functions have no outbound IPv6, so the app connects locally and fails in production
# with "Can't reach database server". Use the connection pooler for DATABASE_URL:
#
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Note the username becomes postgres.<project-ref>. Copy the exact string from the
# Supabase dashboard: Connect -> Transaction pooler.
#
# DIRECT_DATABASE_URL is used ONLY by `prisma migrate`, which needs an uninterrupted
# session for DDL and advisory locks — a transaction-mode pooler cannot provide that.
# Point it at the direct endpoint. Migrations are run from your machine, which does have
# IPv6, so this is fine. If you use a plain Postgres with no pooler, omit it entirely and
# both fall back to DATABASE_URL.
# ---------------------------------------------------------------------------
DIRECT_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Database TLS.
#
# Managed providers often present a certificate signed by their own CA rather than a
# publicly trusted one — Supabase's direct endpoint is issued by "Supabase Intermediate
# 2021 CA", which Node rejects as a self-signed chain. Point DATABASE_CA_CERT_PATH at
# that CA so the connection stays encrypted AND verified.
#
#   DATABASE_CA_CERT_PATH  Path to a .crt file, relative to the project root.
#                          Supabase's CA is bundled at certs/supabase-prod-ca-2021.crt.
#   DATABASE_CA_CERT       The certificate inline as PEM, for hosts where only
#                          environment variables can be set (Vercel, Railway).
#   DATABASE_SSL_NO_VERIFY Set to "true" to skip verification entirely. This is an
#                          explicit escape hatch and is never chosen automatically:
#                          prefer supplying the CA above.
# ---------------------------------------------------------------------------
DATABASE_CA_CERT_PATH="certs/supabase-prod-ca-2021.crt"

# Connections per pool. Each serverless instance opens its own, so keep it small in
# production (default 3) and generous locally (default 10).
# DATABASE_POOL_MAX="3"
# DATABASE_CA_CERT=""
# DATABASE_SSL_NO_VERIFY="false"

# ---------------------------------------------------------------------------
# Admin authentication.
#
#   ADMIN_PASSWORD_HASH   scrypt hash of the admin password.
#                         Generate with:  npm run admin:hash -- "your-password"
#   ADMIN_SESSION_SECRET  Random 32+ byte secret used to sign the admin session cookie.
#                         Generate with:  npm run admin:hash -- --secret
#
# Both are server-only and never reach the client bundle. Never commit real values.
# If either is unset, the admin area refuses every login instead of falling open.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Cron / global sync authorisation.
# GET or POST /api/sync requires:  Authorization: Bearer $CRON_SECRET
# Vercel Cron sends this header automatically when CRON_SECRET is set.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# LeetCode data provider.
#
#   LEETCODE_PROVIDER    "graphql" (default, real data) or "mock" (local dev only).
#                        "mock" is refused when NODE_ENV=production.
#   LEETCODE_API_URL     Override the GraphQL endpoint if you proxy it.
#   LEETCODE_TIMEOUT_MS  Per-request timeout in milliseconds.
#   LEETCODE_MAX_RPS     Client-side throttle in requests per second, to stay polite.
#   LEETCODE_MAX_RETRIES Retry attempts for transient failures (exponential backoff).
# ---------------------------------------------------------------------------
LEETCODE_PROVIDER="graphql"
LEETCODE_API_URL="https://leetcode.com/graphql"
LEETCODE_TIMEOUT_MS="12000"
LEETCODE_MAX_RPS="4"
LEETCODE_MAX_RETRIES="3"

# ---------------------------------------------------------------------------
# Public site URL, used for absolute links.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
